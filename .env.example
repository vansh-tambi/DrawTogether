# ==============================================================================
# DrawTogether Environment Variables
# ==============================================================================

# --- Frontend (Vite / Client) ---
# The WebSocket server URL the browser client will connect to.
# Local development default: ws://localhost:3000
# Production deployment (e.g. on Render/Railway): wss://your-backend.onrender.com
VITE_WS_URL=ws://localhost:3000

# --- Backend (Node.js / WebSocket Server) ---
# The port and host for the server to listen on.
# Hosting platforms (Render, Railway, Fly.io, Heroku) supply PORT automatically.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
